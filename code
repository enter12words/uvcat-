/* ============================================================
 * 5. 动物实体
 * ============================================================ */
class Pet {
  constructor(sp, ci, x, y) {
    this.sp = sp;
    this.spId = sp.id;
    this.ci = ci;
    this.x = x; this.y = y;
    this.dir = Math.random() < 0.5 ? -1 : 1;
    this.state = 'IDLE';
    this.stateT = rand(0.8, 2.5);
    this.t = Math.random() * 20;
    this.vx = 0; this.vy = 0;
    this.bubble = null;
    this.bubbleT = 0;
    this.cryCd = rand(8, 25);
    this.hitFlash = 0;
    this.sleepCd = rand(10, 12);
  }

  startWalk() {
    const s = rand(this.sp.speed[0], this.sp.speed[1]);
    const a = Math.random() * Math.PI * 2;
    this.vx = Math.cos(a) * s;
    this.vy = Math.sin(a) * s * 0.45;
    this.state = 'WALK';
    this.stateT = rand(1.6, 4.0);
  }
  startIdle() {
    this.state = 'IDLE';
    this.stateT = rand(1.0, 3.5);
    this.vx = this.vy = 0;
  }
  startSleep() {
    this.state = 'SLEEP';
    this.sleepT = 15;
    this.vx = this.vy = 0;
  }
  startChat() {
    const list = this.sp.chats || ['Hello'];
    this.bubble = list[Math.floor(Math.random() * list.length)];
    this.bubbleT = 3;
    this.state = 'CHAT';
    this.vx = this.vy = 0;
  }

  update(dt) {
    this.t += dt;
    if (this.hitFlash > 0) this.hitFlash -= dt;
    if (this.sleepCd > 0) this.sleepCd -= dt;

    this.cryCd -= dt;
    if (this.cryCd <= 0) {
      this.cryCd = rand(15, 45);
      if (this.state !== 'SLEEP' && Math.random() < 0.4) Sound.cry(this.spId);
    }

    if (this.state === 'SLEEP') {
      this.sleepT -= dt;
      if (this.sleepT <= 0) {
        this.sleepCd = rand(40, 100);
        this.startIdle();
      }
      return;
    }
    if (this.state === 'CHAT') {
      this.bubbleT -= dt;
      if (this.bubbleT <= 0) { this.bubble = null; this.startIdle(); }
      return;
    }
    if (this.state === 'WALK') {
      this.x += this.vx * dt;
      this.y += this.vy * dt;

      const z = this.sp.zone;
      let bounced = false;
      if (this.x < 46) { this.x = 46; this.vx = Math.abs(this.vx); bounced = true; }
      if (this.x > VW - 46) { this.x = VW - 46; this.vx = -Math.abs(this.vx); bounced = true; }
      if (this.y < z[0]) { this.y = z[0]; this.vy = Math.abs(this.vy); bounced = true; }
      if (this.y > z[1]) { this.y = z[1]; this.vy = -Math.abs(this.vy); bounced = true; }
      if (bounced) this.stateT = Math.min(this.stateT, 0.6);

      if (Math.abs(this.vx) > 0.5) this.dir = this.vx > 0 ? 1 : -1;

      this.stateT -= dt;
      if (this.stateT <= 0) this.startIdle();
      return;
    }

    this.stateT -= dt;
    if (this.stateT <= 0) {
      const r = Math.random();
      if (r < 0.62) this.startWalk();
      else if (r < 0.77 && this.sleepCd <= 0) this.startSleep();
      else if (r < 0.90) this.startChat();
      else this.startIdle();
    }
  }
}

/* ============================================================
 * 6. 收益 & 价格
 * ============================================================ */
function countOf(spId) {
  let n = 0;
  for (let i = 0; i < state.pets.length; i++) {
    if (state.pets[i].spId === spId) n++;
  }
  return n;
}
function speciesRate(spId) {
  const n = countOf(spId);
  if (n <= 0) return 0;
  return COUNT_MULT[n];
}
function totalRate() {
  let sum = 0;
  for (let i = 0; i < SPECIES.length; i++) sum += speciesRate(SPECIES[i].id);
  return sum;
}
function nextPrice(spIndex, owned) {
  const base = (spIndex + 1) * (spIndex + 1);
  return base * (owned + 1) * PRICE_SCALE;
}

