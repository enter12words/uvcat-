  ell(g, x + 5 * s, y - 3 * s, 6 * s, 5 * s, '#4E8C46');
  ell(g, x, y - 6 * s, 7 * s, 5 * s, '#5FA054');
  ell(g, x - 2 * s, y - 7 * s, 3 * s, 2 * s, 'rgba(255,255,255,0.12)');
}
function drawPath(g) {
  const yBase = 425;
  g.fillStyle = '#D8C08A';
  for (let x = 0; x < VW; x++) {
    const y = yBase + Math.sin(x * 0.008) * 26 + Math.sin(x * 0.021) * 8;
    g.fillRect(x, Math.round(y), 1, 22);
  }
  for (let i = 0; i < 160; i++) {
    const x = srand() * VW;
    const y = yBase + Math.sin(x * 0.008) * 26 + Math.sin(x * 0.021) * 8 + srand() * 22;
    px(g, x, y, 2, 1, srand() < 0.5 ? '#C8AE78' : '#E8D2A0');
  }
}

/* ============================================================
 * 8. 动态元素
 * ============================================================ */
const clouds = [];
function initClouds() {
  for (let i = 0; i < 7; i++) {
    clouds.push({
      x: rand(-200, VW + 200),
      y: rand(14, 118),
      s: rand(0.6, 1.5),
      v: rand(4, 11),
      a: rand(0.6, 0.95)
    });
  }
}
function updateClouds(dt) {
  for (const c of clouds) {
    c.x += c.v * dt;
    if (c.x > VW + 140) {
      c.x = -140;
      c.y = rand(14, 118);
      c.s = rand(0.6, 1.5);
      c.v = rand(4, 11);
    }
  }
}
function drawClouds(g, t) {
  for (const c of clouds) {
    g.globalAlpha = c.a;
    const x = c.x, y = c.y + Math.sin(t * 0.4 + c.x * 0.01) * 2;
    const s = c.s;
    ell(g, x, y, 22 * s, 10 * s, '#FFFFFF');
    ell(g, x - 15 * s, y + 3 * s, 14 * s, 8 * s, '#FFFFFF');
    ell(g, x + 15 * s, y + 3 * s, 14 * s, 8 * s, '#FFFFFF');
    ell(g, x - 6 * s, y - 6 * s, 12 * s, 8 * s, '#FFFFFF');
    ell(g, x + 8 * s, y - 5 * s, 10 * s, 7 * s, '#FFFFFF');
    g.globalAlpha = c.a * 0.35;
    ell(g, x, y + 8 * s, 18 * s, 4 * s, '#DCEAF5');
  }
  g.globalAlpha = 1;
}
function drawWaterRipples(g, t) {
  const top = REGION.waterTop, bot = REGION.waterBottom;
  g.globalAlpha = 0.28;
  g.fillStyle = '#BFE5FF';
  for (let i = 0; i < 16; i++) {
    const y = top + 10 + (i * 4) % (bot - top - 16);
    const off = Math.sin(t * 0.9 + i * 1.3) * 26;
    const x = ((i * 137 + t * 16 + off) % (VW + 100)) - 60;
    const w = 14 + (i % 4) * 9;
    g.fillRect(Math.round(x), Math.round(y), w, 1);
  }
  g.globalAlpha = 0.20;
  for (let i = 0; i < 8; i++) {
    const y = top + 16 + (i * 11) % (bot - top - 26);
    const x = ((i * 219 + t * 9) % (VW + 80)) - 40;
    g.fillRect(Math.round(x), Math.round(y), 5 + (i % 3) * 4, 1);
  }
  g.globalAlpha = 1;
}

/* ============================================================
 * 9. 气泡
 * ============================================================ */
function drawBubble(g, x, y, text) {
  g.font = '10px ui-monospace, monospace';
  const tw = Math.ceil(g.measureText(text).width);
  const w = tw + 12;
  const h = 16;
  const bx = Math.round(x - w / 2);
  const by = Math.round(y - h);

  g.fillStyle = 'rgba(255,255,255,0.94)';
  g.fillRect(bx, by, w, h);
  g.fillRect(Math.round(x) - 2, by + h, 4, 2);
  g.fillRect(Math.round(x) - 1, by + h + 2, 2, 2);

  g.fillStyle = 'rgba(120,110,160,0.55)';
  g.fillRect(bx, by, w, 1);
  g.fillRect(bx, by + h - 1, w, 1);
  g.fillRect(bx, by, 1, h);
  g.fillRect(bx + w - 1, by, 1, h);

  g.fillStyle = '#33294F';
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.fillText(text, Math.round(x), by + h / 2 + 0.5);
  g.textAlign = 'left';
  g.textBaseline = 'alphabetic';
}

/* ============================================================
 * 10. 主循环
 * ============================================================ */
const canvas = document.getElementById('scene');
const ctx = canvas.getContext('2d');
ctx.imageSmoothingEnabled = false;

let lastTime = 0;
let uiTimer = 0;
let saveTimer = 0;

function hitTestPet(x, y) {
  const sorted = state.pets.slice().sort((a, b) => a.y - b.y);
  for (let i = sorted.length - 1; i >= 0; i--) {
    const p = sorted[i];
    const dx = x - p.x;
    const dy = y - (p.y - 13);
    if (dx * dx + dy * dy < 19 * 19) return p;
  }
  return null;
}

function update(dt) {
  state.onlineTime += dt;

  const rate = totalRate();
  if (rate > 0) {
    const gain = rate * dt;
    state.coins += gain;
    state.totalCoins += gain;
    state.onlineEarned += gain;
  }

  for (const pet of state.pets) pet.update(dt);

  updateClouds(dt);
  Sound.tick(dt);

  uiTimer -= dt;
  if (uiTimer <= 0) {
    uiTimer = 0.1;
    updateUI();
  }

  saveTimer -= dt;
  if (saveTimer <= 0) {
    saveTimer = SAVE_INTERVAL;
    save();
  }
}

function render(t) {
  ctx.drawImage(bgCanvas, 0, 0);
  drawClouds(ctx, t);
  drawWaterRipples(ctx, t);

  const all = state.pets.slice();
  all.sort((a, b) => a.y - b.y);
  for (const pet of all) drawPet(ctx, pet);
}

function drawPet(g, pet) {
  const p = pet.sp.pals[pet.ci];
  g.save();
  g.translate(Math.round(pet.x), Math.round(pet.y));

  g.globalAlpha = 0.22;
  ell(g, 0, 0, 9, 3, '#000');
  g.globalAlpha = 1;

  if (pet.hitFlash > 0) {
    g.globalAlpha = Math.min(1, pet.hitFlash * 2.4);
    ell(g, 0, -14, 17, 15, '#FFD166');
    g.globalAlpha = 1;
  }

  if (pet.dir < 0) g.scale(-1, 1);

  let bob = 0;
  if (pet.state === 'WALK') bob = Math.sin(pet.t * 10) * 1;
  else if (pet.state === 'IDLE') bob = Math.sin(pet.t * 2) * 0.6;
  else if (pet.hitFlash > 0) bob = -Math.sin(pet.hitFlash * 12) * 2.5;
  g.translate(0, Math.round(bob));

  const drawer = DRAWERS[pet.spId];
  if (drawer) drawer(g, p);

  g.restore();

  if (pet.bubble) {
    drawBubble(g, pet.x, pet.y - 34, pet.bubble);
  }
  if (pet.state === 'SLEEP') {
    const phase = Math.floor((pet.t * 1.2) % 3);
    const zt = 'Z'.repeat(phase + 1);
    drawBubble(g, pet.x + 12, pet.y - 34 - phase * 3, zt);
  }
}

function loop(now) {
  if (!lastTime) lastTime = now;
  let dt = (now - lastTime) / 1000;
  lastTime = now;
  if (dt > 0.25) dt = 0.25;
  if (dt < 0) dt = 0;

  update(dt);
  render(now / 1000);

  requestAnimationFrame(loop);
}

