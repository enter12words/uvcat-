function buySpecies(index) {
  const sp = SPECIES[index];
  const owned = countOf(sp.id);
  if (owned >= MAX_PER_SPECIES) return;

  const price = nextPrice(index, owned);
  if (state.coins < price) {
    Sound.deny();
    return;
  }

  state.coins -= price;
  spawnPet(sp, owned);
  Sound.buy();
  updateUI();
}

function spawnPet(sp, ownedCount) {
  const ci = ownedCount % sp.pals.length;
  const x = rand(90, VW - 90);
  const y = rand(sp.zone[0], sp.zone[1]);
  const pet = new Pet(sp, ci, x, y);
  state.pets.push(pet);
  return pet;
}

