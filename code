  }
}
function drawTree(g, x, y, s, dark, light) {
  x = Math.round(x); y = Math.round(y);
  px(g, x - 2 * s, y - 9 * s, 4 * s, 9 * s, '#5A4030');
  px(g, x - 2 * s, y - 9 * s, 1.5 * s, 9 * s, '#483426');
  ell(g, x, y - 17 * s, 10 * s, 8 * s, dark);
  ell(g, x - 6 * s, y - 13 * s, 7 * s, 6 * s, dark);
  ell(g, x + 6 * s, y - 13 * s, 7 * s, 6 * s, dark);
  ell(g, x, y - 19 * s, 8 * s, 6 * s, light);
  ell(g, x - 3 * s, y - 20 * s, 4 * s, 3 * s, 'rgba(255,255,255,0.12)');
}
function drawBamboo(g, x, y, h, s) {
  x = Math.round(x); y = Math.round(y);
  const w = Math.max(2, 3 * s);
  px(g, x, y - h, w, h, '#8BBF55');
