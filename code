  load();

  el.btnSound.textContent = state.sound ? '🔊 音效' : '🔇 静音';
  Sound.enabled = state.sound;

  updateTutorialButtons();
  fitStage();
  updateUI();

  // 首次进入（教程未完成）自动显示教程弹窗
  if (!tutorialDone) {
    showTutorial();
  }

  requestAnimationFrame(loop);
}

init();

})();
</script>
</body>
</html>
