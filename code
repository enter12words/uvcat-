/* ============================================================
 * 15. 存档
 * ============================================================ */
function save() {
  try {
    const data = {
      v: 4,
      coins: state.coins,
      totalCoins: state.totalCoins,
      clicks: state.clicks,
      onlineTime: state.onlineTime,
      offlineTime: state.offlineTime,
      onlineEarned: state.onlineEarned,
      offlineEarned: state.offlineEarned,
      sound: state.sound,
      tutorialDone: tutorialDone,
      tutorialSupported: tutorialSupported,
      hasOpenedPanel: hasOpenedPanel,
      species: SPECIES.map(sp => {
        const list = state.pets.filter(p => p.spId === sp.id);
        return { id: sp.id, colors: list.map(p => p.ci) };
      }),
      lastTime: Date.now()
    };
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
  } catch (e) { /* 静默 */ }
}

function load() {
  let data = null;
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return false;
    data = JSON.parse(raw);
  } catch (e) { return false; }
  if (!data) return false;

  state.coins = data.coins || 0;
  state.totalCoins = data.totalCoins || 0;
  state.clicks = data.clicks || 0;
  state.onlineTime = data.onlineTime || 0;
  state.offlineTime = data.offlineTime || 0;
  state.onlineEarned = data.onlineEarned || 0;
  state.offlineEarned = data.offlineEarned || 0;
  state.sound = data.sound !== false;
  tutorialDone = !!data.tutorialDone;
  tutorialSupported = !!data.tutorialSupported;
  hasOpenedPanel = !!data.hasOpenedPanel;

  state.pets.length = 0;
  if (Array.isArray(data.species)) {
    data.species.forEach(entry => {
      const sp = SPECIES.find(s => s.id === entry.id);
      if (!sp) return;
      const colors = Array.isArray(entry.colors) ? entry.colors : [];
      colors.slice(0, MAX_PER_SPECIES).forEach((ci) => {
        const pet = new Pet(sp, ci % sp.pals.length,
          rand(90, VW - 90), rand(sp.zone[0], sp.zone[1]));
        state.pets.push(pet);
      });
    });
  }

  const now = Date.now();
  const elapsed = Math.max(0, (now - (data.lastTime || now)) / 1000);

  if (elapsed > 10) {
    const rate = totalRate();
    const offGain = elapsed * rate * OFFLINE_EFF;
    state.offlineTime += elapsed;
    if (offGain > 0) {
      state.coins += offGain;
      state.totalCoins += offGain;
      state.offlineEarned += offGain;
    }
    showOfflineModal(elapsed, offGain);
  }

  return true;
}

function doReset() {
  // 清掉所有版本的存档 key（防止旧数据残留）
  ['pixelzoo_save_v1', 'pixelzoo_save_v2', 'pixelzoo_save_v3', 'pixelzoo_save_v4']
    .forEach(k => {
      try { localStorage.removeItem(k); } catch (e) {}
    });

  // 就地重置内存状态
  state.coins = 0;
  state.totalCoins = 0;
  state.clicks = 0;
  state.onlineTime = 0;
  state.offlineTime = 0;
  state.onlineEarned = 0;
  state.offlineEarned = 0;
  state.pets.length = 0;

  tutorialDone = false;
  tutorialSupported = false;
  hasOpenedPanel = false;

  // 关闭商店面板，重新显示教程
  panelHidden = true;
  panelEl.classList.add('hidden');
  showTutorial();

  // 刷新 UI 并写入新的空存档
  updateUI();
  save();

  Sound.deny();
}

