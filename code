const Sound = {
  ctx: null,
  enabled: true,
  ambient: null,
  birdTimer: 4,

  init() {
    if (this.ctx) return;
    try {
      this.ctx = new (window.AudioContext || window.webkitAudioContext)();
    } catch (e) { this.ctx = null; }
  },
  resume() {
    this.init();
    if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
  },
  tone(freq, dur, type, vol, delay) {
    if (!this.enabled || !this.ctx) return;
    const c = this.ctx, t = c.currentTime + (delay || 0);
    const o = c.createOscillator(), g = c.createGain();
    o.type = type || 'square';
    o.frequency.setValueAtTime(freq, t);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol || 0.05, t + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(c.destination);
    o.start(t); o.stop(t + dur + 0.03);
  },
  slide(f0, f1, dur, type, vol, delay) {
    if (!this.enabled || !this.ctx) return;
    const c = this.ctx, t = c.currentTime + (delay || 0);
    const o = c.createOscillator(), g = c.createGain();
    o.type = type || 'sine';
    o.frequency.setValueAtTime(f0, t);
    o.frequency.exponentialRampToValueAtTime(Math.max(30, f1), t + dur);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol || 0.05, t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(c.destination);
    o.start(t); o.stop(t + dur + 0.08);
  },

  click() { this.tone(760, 0.045, 'square', 0.030); },
  coin()  { this.tone(1180, 0.05, 'square', 0.028); this.tone(1560, 0.08, 'square', 0.020, 0.045); },
  buy()   { [523, 659, 784, 1046].forEach((f, i) => this.tone(f, 0.1, 'square', 0.042, i * 0.055)); },
  deny()  { this.tone(180, 0.12, 'sawtooth', 0.028); },
  panel() { this.tone(520, 0.05, 'square', 0.028); this.tone(780, 0.06, 'square', 0.022, 0.05); },
  support() {
    [659, 784, 988, 1319].forEach((f, i) => this.tone(f, 0.14, 'triangle', 0.05, i * 0.07));
    this.tone(1568, 0.22, 'triangle', 0.04, 0.30);
  },

  cry(id) {
    switch (id) {
      case 'chick': case 'partridge':
        this.slide(1900, 2500, 0.09, 'sine', 0.030, 0);
        this.slide(2200, 2800, 0.08, 'sine', 0.024, 0.10);
        break;
      case 'duck': case 'goose':
        this.slide(640, 400, 0.14, 'sawtooth', 0.030, 0);
        this.slide(600, 360, 0.13, 'sawtooth', 0.024, 0.16);
        break;
      case 'cat':
        this.slide(780, 640, 0.16, 'triangle', 0.034, 0);
        this.slide(700, 500, 0.15, 'triangle', 0.026, 0.17);
        break;
      case 'dog':
        this.slide(440, 260, 0.10, 'square', 0.036, 0);
        this.slide(420, 240, 0.10, 'square', 0.030, 0.13);
        break;
      case 'lion': case 'tiger': case 'wolf':
        this.slide(250, 110, 0.42, 'sawtooth', 0.036, 0);
        break;
      case 'polarbear': case 'panda':
        this.slide(200, 130, 0.32, 'sine', 0.030, 0);
        break;
      default:
        this.slide(900, 1200, 0.09, 'sine', 0.024, 0);
        this.slide(1050, 1350, 0.08, 'sine', 0.020, 0.10);
        break;
    }
  },

  startAmbient() {
    if (!this.ctx || this.ambient) return;
    const c = this.ctx;
    const len = c.sampleRate * 2;
    const buf = c.createBuffer(1, len, c.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1);
    const src = c.createBufferSource();
    src.buffer = buf; src.loop = true;
    const lp = c.createBiquadFilter();
    lp.type = 'lowpass'; lp.frequency.value = 320; lp.Q.value = 0.6;
    const gain = c.createGain(); gain.gain.value = 0.010;
    const lfo = c.createOscillator(), lfoGain = c.createGain();
    lfo.frequency.value = 0.09; lfoGain.gain.value = 0.007;
    lfo.connect(lfoGain); lfoGain.connect(gain.gain);
    lfo.start();
    src.connect(lp); lp.connect(gain); gain.connect(c.destination);
    src.start();
    this.ambient = { src, gain };
  },

  tick(dt) {
    if (!this.enabled || !this.ctx) return;
    this.birdTimer -= dt;
    if (this.birdTimer <= 0) {
      this.birdTimer = rand(3, 9);
      const base = rand(1600, 2600);
      this.slide(base, base * rand(1.2, 1.7), 0.1, 'sine', 0.016, 0);
      if (Math.random() < 0.5) {
        this.slide(base * 1.1, base * 0.8, 0.09, 'sine', 0.012, 0.16);
      }
    }
  },

  setEnabled(v) {
    this.enabled = v;
    if (this.ambient) {
      this.ambient.gain.gain.setTargetAtTime(v ? 0.010 : 0, this.ctx.currentTime, 0.1);
    }
  }
};

