function updateShop() {
  SPECIES.forEach((sp, i) => {
    const ui = shopEls[i];
    if (!ui) return;

    const owned = countOf(sp.id);
    const price = nextPrice(i, owned);
    const r = speciesRate(sp.id);

    ui.owned.textContent = owned + '/3';
    ui.owned.classList.toggle('full', owned >= MAX_PER_SPECIES);

    ui.price.textContent = fmt(price);
    ui.price.classList.toggle('no', state.coins < price);

    ui.rate.textContent = '+' + r.toFixed(1) + '/秒';
    ui.rate.classList.toggle('zero', r <= 0);

    const maxed = owned >= MAX_PER_SPECIES;
    const canBuy = !maxed && state.coins >= price;
    ui.buy.disabled = !canBuy;
    ui.buy.textContent = maxed ? '已满' : '购买';
  });
}

