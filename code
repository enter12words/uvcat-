<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>uvcat Animal</title>
<style>
  :root{
    --deb-red:#D70A53;
    --deb-red-hi:#FF3B7F;
    --deb-red-lo:#A80030;
    --panel:#141418;
    --panel-2:#1a1a1f;
    --panel-3:#0f0f13;
    --line:#2a2a32;
    --line-soft:#1e1e24;
    --text:#ececf0;
    --muted:#85858f;
    --dim:#585862;
    --gold:#FFD166;
    --green:#7fe08c;
    --blue:#6ab0ff;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{
    width:100%;height:100%;overflow:hidden;background:#000;
    font-family:ui-monospace,"PingFang SC","Microsoft YaHei",Menlo,Consolas,monospace;
    user-select:none;
  }
  #stage{
    position:absolute;left:50%;top:50%;
    margin-left:-480px;margin-top:-270px;
    width:960px;height:540px;
    transform-origin:center center;
  }
  canvas#scene{
    display:block;width:960px;height:540px;
    image-rendering:pixelated;
    image-rendering:-moz-crisp-edges;
    image-rendering:crisp-edges;
    cursor:crosshair;
    background:#7ec8f0;
  }

  #ui{position:absolute;inset:0;pointer-events:none;font-size:12px;}
  #ui > *{pointer-events:auto;}

  /* ============ 商店面板 ============ */
  #panel{
    position:absolute;right:14px;top:22px;
    width:306px;height:496px;
    display:flex;flex-direction:column;
    background:var(--panel);
    border:1px solid #33333c;
    border-radius:4px;
    box-shadow:
      0 0 0 1px #000,
      0 8px 26px rgba(0,0,0,.75);
    color:var(--text);
    overflow:hidden;
    transition:opacity .18s ease, transform .18s ease;
  }
  #panel.hidden{
    opacity:0;
    transform:translateX(14px) scale(.98);
    pointer-events:none;
  }

  .panel-head{
    display:flex;align-items:center;gap:6px;
    padding:8px 10px;
    border-bottom:1px solid var(--line);
    background:var(--panel-2);
    flex:0 0 auto;
  }
  .dot{width:8px;height:8px;border-radius:50%;flex:0 0 8px;}
  .dot.r{background:#ff5f56;}
  .dot.y{background:#ffbd2e;}
  .dot.g{background:#27c93f;}
  .panel-title{
    flex:1;font-size:10px;letter-spacing:3px;
    color:var(--muted);font-weight:bold;padding-left:4px;
  }
  .panel-key{
    font-size:9px;letter-spacing:1px;color:var(--dim);
    border:1px solid var(--line);padding:1px 5px;border-radius:2px;
  }

  /* 特别猫（uvcat）卡片 */
  #cat-card{
    display:flex;align-items:center;gap:10px;
    padding:8px 10px;
    border-bottom:1px solid var(--line);
    background:#16161b;
    cursor:pointer;
    flex:0 0 auto;
    transition:background .12s;
    overflow:hidden;
  }
  #cat-card:hover{background:#1d1d24;}
  #cat-card:active{background:#22222a;}
  .cat-emoji{
    width:56px;height:56px;flex:0 0 56px;
    display:flex;align-items:center;justify-content:center;
    font-size:38px;line-height:1;
    animation:catBob 2.4s ease-in-out infinite;
    transform-origin:center bottom;
    transition:transform .12s;
  }
  @keyframes catBob{
    0%,100%{transform:translateY(0) rotate(-4deg);}
    50%{transform:translateY(-4px) rotate(4deg);}
  }
  #cat-card:active .cat-emoji{
    animation:none;
    transform:scale(1.18) rotate(-6deg);
  }
  #cat-card.flash .cat-emoji{
    animation:catFlash .42s ease-out;
  }
  @keyframes catFlash{
    0%{transform:scale(1) rotate(0deg);filter:drop-shadow(0 0 0 #FFD166);}
    35%{transform:scale(1.35) rotate(-10deg);filter:drop-shadow(0 0 14px #FFD166);}
    100%{transform:scale(1) rotate(0deg);filter:drop-shadow(0 0 0 #FFD166);}
  }
  .cat-meta{flex:1;min-width:0;}
  .cat-name{
    font-size:11px;font-weight:bold;color:#fff;
    letter-spacing:.5px;
    display:flex;align-items:center;gap:4px;
  }
  .cat-name .tag{
    font-size:8px;color:var(--deb-red);border:1px solid var(--deb-red);
    padding:0 3px;border-radius:2px;letter-spacing:1px;
  }
  .cat-desc{
    font-size:9.5px;color:var(--muted);margin-top:3px;line-height:1.5;
  }
  .cat-desc b{color:var(--gold);font-weight:bold;}

  /* 支持作者卡片 */
  #support-card{
    display:flex;align-items:center;gap:10px;
    padding:8px 10px;
    border-bottom:1px solid var(--line);
    background:#16161b;
    cursor:pointer;
    flex:0 0 auto;
    transition:background .12s;
    overflow:hidden;
  }
  #support-card:hover{background:#1d1d24;}
  #support-card:active{background:#22222a;}
  .sup-icon{
    width:56px;height:56px;flex:0 0 56px;
    display:flex;align-items:center;justify-content:center;
    font-size:34px;line-height:1;
    animation:supBob 2.6s ease-in-out infinite;
    transform-origin:center center;
    transition:transform .12s;
  }
  @keyframes supBob{
    0%,100%{transform:scale(1) rotate(-3deg);}
    50%{transform:scale(1.08) rotate(3deg);}
  }
  #support-card:active .sup-icon{
    animation:none;
    transform:scale(1.2) rotate(-6deg);
  }
  #support-card.flash .sup-icon{
    animation:supFlash .6s ease-out;
  }
  @keyframes supFlash{
    0%{transform:scale(1) rotate(0deg);filter:drop-shadow(0 0 0 #D70A53);}
    35%{transform:scale(1.75) rotate(-12deg);filter:drop-shadow(0 0 20px #FF3B7F);}
    100%{transform:scale(1) rotate(0deg);filter:drop-shadow(0 0 0 transparent);}
  }
  .sup-meta{flex:1;min-width:0;}
  .sup-name{
    font-size:11px;font-weight:bold;color:#fff;
    letter-spacing:.5px;
  }
  .sup-desc{
    font-size:9.5px;color:var(--muted);margin-top:3px;line-height:1.5;
  }
  .sup-desc b{color:var(--gold);font-weight:bold;}

  /* 金币条 */
  .coin-bar{
    display:flex;align-items:center;justify-content:space-between;
    padding:8px 12px;
    background:var(--panel-3);
    border-bottom:1px solid var(--line);
    flex:0 0 auto;
  }
  .coin-bar .label{
    font-size:9px;letter-spacing:2px;color:var(--dim);margin-bottom:2px;
  }
  .coin-bar .val{
    font-size:17px;font-weight:bold;color:var(--gold);
    line-height:1;letter-spacing:.5px;
  }
  .coin-bar .rate{
    font-size:12px;font-weight:bold;color:var(--green);line-height:1;
    text-align:right;
  }

  /* Tabs */
  .tabs{
    display:flex;
    border-bottom:1px solid var(--line);
    background:var(--panel-2);
    flex:0 0 auto;
  }
  .tab{
    flex:1;padding:8px 0;
    background:none;border:none;border-bottom:2px solid transparent;
    font-family:inherit;font-size:10px;letter-spacing:2px;font-weight:bold;
    color:var(--muted);cursor:pointer;
    transition:color .14s,border-color .14s;
  }
  .tab:hover{color:#c8c8d0;}
  .tab.active{
    color:var(--deb-red);
    border-bottom-color:var(--deb-red);
  }

  /* 内容区 */
  .pane{
    flex:1 1 auto;
    overflow-y:auto;overflow-x:hidden;
    min-height:0;
  }
  .pane.hidden{display:none;}
  .pane::-webkit-scrollbar{width:5px;}
  .pane::-webkit-scrollbar-track{background:#0d0d10;}
  .pane::-webkit-scrollbar-thumb{background:#3a3a44;border-radius:0;}
  .pane::-webkit-scrollbar-thumb:hover{background:#4a4a56;}

  /* 商店条目 */
  .shop-item{
    display:flex;align-items:center;gap:8px;
    padding:7px 10px;
    border-bottom:1px solid var(--line-soft);
    transition:background .12s;
  }
  .shop-item:hover{background:#1a1a20;}
  .si-emoji{
    width:20px;flex:0 0 20px;text-align:center;font-size:14px;
    line-height:1;
  }
  .si-info{flex:1;min-width:0;}
  .si-name{
    display:flex;justify-content:space-between;align-items:baseline;
    font-size:11px;color:var(--text);letter-spacing:.3px;
  }
  .si-owned{font-size:9px;color:var(--dim);letter-spacing:.5px;}
  .si-owned.full{color:var(--deb-red);}
  .si-sub{
    display:flex;justify-content:space-between;align-items:baseline;
    font-size:9.5px;color:var(--muted);margin-top:3px;
  }
  .si-price{color:var(--gold);}
  .si-price.no{color:#6a5a3a;}
  .si-rate{color:var(--green);}
  .si-rate.zero{color:#3f5a44;}
  .si-buy{
    flex:0 0 auto;
    font-family:inherit;font-size:9px;font-weight:bold;letter-spacing:1px;
    padding:5px 9px;border-radius:2px;cursor:pointer;
    background:var(--deb-red);
    border:1px solid var(--deb-red-hi);
    color:#fff;
    box-shadow:0 1px 0 var(--deb-red-lo);
    transition:background .12s,transform .06s;
  }
  .si-buy:hover:not(:disabled){background:var(--deb-red-hi);}
  .si-buy:active:not(:disabled){transform:translateY(1px);box-shadow:none;}
  .si-buy:disabled{
    background:#25252c;border-color:#33333c;color:#4e4e58;
    box-shadow:none;cursor:not-allowed;
  }

  /* 统计 */
  .stat-group{
    padding:9px 12px 3px;
    font-size:9px;letter-spacing:2px;font-weight:bold;
    color:var(--deb-red);
  }
  .stat-row{
    display:flex;justify-content:space-between;align-items:baseline;
    padding:5px 12px;
    font-size:10.5px;color:var(--muted);
    border-bottom:1px solid var(--line-soft);
  }
  .stat-row b{color:var(--text);font-weight:normal;letter-spacing:.5px;}
  .stat-row b.on{color:var(--green);}
  .stat-row b.off{color:var(--blue);}
  .stat-row b.gold{color:var(--gold);}

  /* 底部按钮 */
  .panel-foot{
    display:flex;gap:8px;
    padding:8px 10px;
    border-top:1px solid var(--line);
    background:var(--panel-2);
    flex:0 0 auto;
  }
  .pbtn{
    flex:1;
    padding:6px 0;
    font-family:inherit;font-size:9px;font-weight:bold;letter-spacing:1.5px;
    background:#1f1f26;border:1px solid #33333c;color:var(--muted);
    border-radius:2px;cursor:pointer;
    transition:background .12s,color .12s,border-color .12s;
  }
  .pbtn:hover{background:#28282f;color:#c8c8d0;border-color:#44444e;}
  .pbtn.danger:hover{color:var(--deb-red);border-color:var(--deb-red);}

  /* ============ 弹窗 ============ */
  #modal, #tutorial{
    position:absolute;inset:0;z-index:50;
    display:flex;align-items:center;justify-content:center;
    background:rgba(4,4,6,.82);
    backdrop-filter:blur(2px);
  }
  #tutorial{z-index:60;}
  #modal.hide, #tutorial.hide{display:none;}
  .modal-box{
    width:340px;padding:24px 22px 20px;text-align:center;
    background:var(--panel);
    border:1px solid #33333c;
    border-radius:4px;
    box-shadow:0 0 0 1px #000, 0 10px 40px rgba(0,0,0,.8);
    animation:pop .28s cubic-bezier(.2,1.4,.5,1);
  }
  @keyframes pop{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
  .modal-box .m-head{
    font-size:11px;letter-spacing:3px;color:var(--deb-red);
    font-weight:bold;margin-bottom:16px;
  }
  .modal-box .m-line{
    font-size:10.5px;color:var(--muted);line-height:1.9;letter-spacing:.5px;
  }
  .modal-box .m-line b{color:var(--text);font-weight:normal;}
  .modal-box .m-big{
    display:block;margin:12px 0 18px;
    font-size:24px;font-weight:bold;color:var(--gold);letter-spacing:1px;
  }
  .modal-box button{
    font-family:inherit;font-size:11px;font-weight:bold;letter-spacing:2px;
    padding:9px 30px;border-radius:2px;cursor:pointer;color:#fff;
    background:var(--deb-red);
    border:1px solid var(--deb-red-hi);
    box-shadow:0 2px 0 var(--deb-red-lo);
    transition:background .12s,transform .06s;
  }
  .modal-box button:hover:not(:disabled){background:var(--deb-red-hi);}
  .modal-box button:active:not(:disabled){transform:translateY(2px);box-shadow:none;}
  .modal-box button:disabled{
    background:#23232a;border-color:#33333c;color:#4e4e58;
    box-shadow:none;cursor:not-allowed;
  }

  /* ============ 教程弹窗 ============ */
  .tut-box{
    width:400px;padding:26px 26px 22px;
    background:var(--panel);
    border:1px solid #33333c;
    border-radius:4px;
    box-shadow:0 0 0 1px #000, 0 12px 46px rgba(0,0,0,.85);
    color:var(--text);
    text-align:center;
    animation:pop .3s cubic-bezier(.2,1.4,.5,1);
  }
  .tut-emoji{
    font-size:34px;line-height:1;margin-bottom:10px;
    animation:catBob 2.4s ease-in-out infinite;
    display:inline-block;
  }
  .tut-title{
    font-size:17px;font-weight:bold;color:#fff;letter-spacing:2px;
    margin-bottom:16px;
  }
  .tut-title span{color:var(--deb-red);}
  .tut-body{
    font-size:11.5px;color:#b9b9c4;line-height:2;
    text-align:left;letter-spacing:.3px;
    padding:14px 16px;
    background:var(--panel-3);
    border:1px solid var(--line-soft);
    border-radius:3px;
    margin-bottom:16px;
  }
  .tut-body p{margin-bottom:8px;}
  .tut-body p:last-child{margin-bottom:0;}
  .tut-body b{color:var(--gold);font-weight:bold;}
  .tut-gift{
    font-size:10.5px;color:var(--dim);margin-bottom:14px;
    letter-spacing:.3px;line-height:1.7;
  }
  .tut-gift b{color:var(--green);}
  .tut-btns{display:flex;flex-direction:column;gap:9px;}
  .tut-btn{
    font-family:inherit;font-size:11.5px;font-weight:bold;letter-spacing:2px;
    padding:11px 20px;border-radius:3px;cursor:pointer;
    transition:background .14s,transform .06s,border-color .14s,color .14s;
  }
  .tut-btn.primary{
    background:var(--deb-red);
    border:1px solid var(--deb-red-hi);
    color:#fff;
    box-shadow:0 2px 0 var(--deb-red-lo);
  }
  .tut-btn.primary:hover:not(:disabled){background:var(--deb-red-hi);}
  .tut-btn.primary:active:not(:disabled){transform:translateY(2px);box-shadow:none;}
  .tut-btn.supported{
    background:#16241a;
    border:1px solid #2d4a34;
    color:var(--green);
    box-shadow:none;cursor:default;
  }
  .tut-btn.shake{
    animation:tutShake .42s ease;
  }
  @keyframes tutShake{
    0%,100%{transform:translateX(0);}
    20%,60%{transform:translateX(-6px);}
    40%,80%{transform:translateX(6px);}
  }
  .tut-hint{
    margin-top:16px;
    font-size:11px;color:#b9b9c4;
    letter-spacing:.5px;
    animation:tutPulse 1.8s ease-in-out infinite;
  }
  .tut-hint.hidden{display:none;}
  .tut-hint .key{
    display:inline-block;
    padding:3px 10px;margin:0 4px;
    border:1px solid var(--deb-red);
    border-radius:3px;
    color:var(--deb-red);
    font-weight:bold;font-size:10.5px;
    letter-spacing:1.5px;
    background:rgba(215,10,83,.08);
  }
  @keyframes tutPulse{
    0%,100%{opacity:.72;}
    50%{opacity:1;}
  }
</style>
</head>
<body>
<div id="stage">
  <canvas id="scene" width="960" height="540"></canvas>

  <div id="ui">
    <!-- ===== 商店面板 ===== -->
    <div id="panel" class="hidden">
      <div class="panel-head">
        <span class="dot r"></span>
        <span class="dot y"></span>
        <span class="dot g"></span>
        <span class="panel-title">像素动物园</span>
        <span class="panel-key">回车</span>
      </div>

      <!-- uvcat 特别猫 -->
      <div id="cat-card" title="点我领金币">
        <div class="cat-emoji">🐱</div>
        <div class="cat-meta">
          <div class="cat-name">uvcat <span class="tag">限定</span></div>
          <div class="cat-desc">
            点我 <b>+2</b> 金币<br>
            哈！
          </div>
        </div>
      </div>

      <!-- 支持作者 -->
      <div id="support-card" title="支持作者">
        <div class="sup-icon">❤️</div>
        <div class="sup-meta">
          <div class="sup-name">支持作者</div>
        </div>
      </div>

      <!-- 金币条 -->
      <div class="coin-bar">
        <div>
          <div class="label">金币</div>
          <div class="val" id="coins">0</div>
        </div>
        <div style="text-align:right">
          <div class="label" style="text-align:right">收益</div>
          <div class="rate" id="rate">0.0/秒</div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="tabs">
        <button class="tab active" data-tab="shop">商店</button>
        <button class="tab" data-tab="stats">统计</button>
      </div>

      <!-- 商店 -->
      <div id="pane-shop" class="pane">
        <div id="shop-list"></div>
      </div>

      <!-- 统计 -->
      <div id="pane-stats" class="pane hidden">
        <div class="stat-group">时间</div>
        <div class="stat-row"><span>在线时长</span><b id="s-online">00:00:00</b></div>
        <div class="stat-row"><span>离线时长</span><b id="s-offline">00:00:00</b></div>

        <div class="stat-group">记录</div>
        <div class="stat-row"><span>点击次数</span><b id="s-clicks">0</b></div>
        <div class="stat-row"><span>动物数量</span><b id="s-pets">0 / 54</b></div>

        <div class="stat-group">收益</div>
        <div class="stat-row"><span>在线收益</span><b class="on" id="s-one">0</b></div>
        <div class="stat-row"><span>离线收益</span><b class="off" id="s-offe">0</b></div>
        <div class="stat-row"><span>总金币</span><b class="gold" id="s-total">0</b></div>
      </div>

      <div class="panel-foot">
        <button class="pbtn" id="btn-sound">🔊 音效</button>
        <button class="pbtn danger" id="btn-reset">重置</button>
      </div>
    </div>
  </div>

  <!-- ===== 新手教程 ===== -->
  <div id="tutorial" class="hide">
    <div class="tut-box">
      <div class="tut-emoji">🐾</div>
      <div class="tut-title">欢迎来到<span>像素动物园</span></div>
      <div class="tut-body">
        <p>这是一个安静的像素动物园。</p>
        <p>点击画面任意位置赚取金币，购买你喜欢的动物。</p>
        <p>动物会自己散步、睡觉、聊天，并为你持续产生收益。</p>
        <p>即使关闭页面，它们也会继续帮你工作。</p>
      </div>
      <div class="tut-gift" id="tut-gift">点击下方按钮支持作者，即可获得一只 <b>小鸡 🐤</b></div>
      <div class="tut-btns">
        <button class="tut-btn primary" id="tut-support">❤ 支持作者 uvcat</button>
      </div>
      <div class="tut-hint hidden" id="tut-hint">
        按 <span class="key">ENTER</span> 打开商店
      </div>
    </div>
  </div>

  <!-- ===== 离线结算 ===== -->
  <div id="modal" class="hide">
    <div class="modal-box">
      <div class="m-head">欢迎回来</div>
      <div class="m-line">你离开了 <b id="m-time">00:00:00</b></div>
      <div class="m-line">动物们帮你赚到了</div>
      <span class="m-big" id="m-coins">0</span>
      <button id="m-close">收下</button>
    </div>
  </div>
</div>

<script>
/* ============================================================
 *  像素动物园 · PIXEL ZOO IDLE
 *  ------------------------------------------------------------
 *  Canvas 层 : 天空 / 地形 / 水面 / 树木 / 动物 / 动画 / 气泡
 *  DOM   层 : 单一面板（商店 + 统计 + uvcat + 支持作者）
 *  键盘   : 回车 打开/关闭面板（首次进入教程）
 * ============================================================ */
(function () {
'use strict';

/* ============================================================
 * 0. 常量 & 工具
 * ============================================================ */
const VW = 960, VH = 540;
const SAVE_KEY = 'pixelzoo_save_v4';
const OFFLINE_EFF = 0.2;
const MAX_PER_SPECIES = 3;
const COUNT_MULT = [0, 1, 1.4, 1.8];
const SAVE_INTERVAL = 5;
const PRICE_SCALE = 12;

function px(g, x, y, w, h, c) {
  g.fillStyle = c;
  g.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h));
}
function ell(g, cx, cy, rx, ry, c) {
  cx = Math.round(cx); cy = Math.round(cy);
  rx = Math.max(1, Math.round(rx)); ry = Math.max(1, Math.round(ry));
  g.fillStyle = c;
